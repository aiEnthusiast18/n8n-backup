    {
      "id": "1a2a6997-48ee-44a3-870d-54761c55ddad",
      "name": "Find unsubscribe replies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const have = new Set($('Get opt-outs').all().map(i => String(i.json.email || '').toLowerCase().trim()));\nconst out = [];\nfor (const m of $('Get recent mail').all().map(i => i.json)) {\n  const subj = String(m.subject || '');\n  if (!/check-in about cleaning/i.test(subj) || /^\\s*\\[TEST/i.test(subj)) continue;\n  const email = String((m.from && m.from.emailAddress && m.from.emailAddress.address) || '').toLowerCase().trim();\n  if (!email || /@anagomb\\.ca$/.test(email) || have.has(email)) continue;\n  // only the reply itself, not the quoted original (which contains the word unsubscribe)\n  const reply = String(m.bodyPreview || '').split(/\\bFrom:|-----Original|\\bOn .{5,80} wrote:|Hi [^,]{1,40},\\s+In 20\\d\\d we/i)[0];\n  if (!/unsubscri|remove me|stop email|take me off/i.test(reply)) continue;\n  have.add(email);\n  out.push({ json: { email, subject: subj } });\n}\nreturn out;\n"
      }
    },
