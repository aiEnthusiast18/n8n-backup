        "jsCode": "const req = $('Request').first().json.body;\nconst fields = req.fields;\nlet rows = []; const statuses = []; let extra = null;\nfor (const it of $input.all()) {\n  const r = it.json; statuses.push(r.statusCode);\n  const b = r.body || {};\n  if (Array.isArray(b.data)) rows = rows.concat(b.data);\n  else if (b.data !== undefined) rows.push(b.data);\n  if (b.success === false) extra = { error: b.error, error_info: b.error_info };\n}\nif (fields) rows = rows.map(x => { const o = {}; for (const f of fields) o[f] = x == null ? null : x[f]; return o; });\nreturn [{ json: { statuses, count: rows.length, error: extra, data: rows } }];"
