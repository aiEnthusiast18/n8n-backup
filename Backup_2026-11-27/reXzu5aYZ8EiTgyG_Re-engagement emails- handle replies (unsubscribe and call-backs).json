    {
      "id": "b9f5d570-3f7b-4e62-82e4-39654a1a0efe",
      "name": "Find replies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const lc = s => String(s || '').toLowerCase().trim();\nconst optout = new Set($('Get opt-outs').all().map(i => lc(i.json.email)));\nconst replied = $('Get replies').all().map(i => i.json);\n// One-time backfill: when run by hand, redo these replies that came in before campaign deals existed.\nconst REDO = new Set($execution.mode !== 'production' ? [\n  'AAMkADI4OGIzNzUxLTRlMGMtNDY2Zi04NmVlLWZhOTFhM2MxNjcwZABGAAAAAACwYBVdW2_fR5jdz7PbeAFBBwCJ_gbiNQxfTY7RW4ho2z5DAAAAAAEMAACJ_gbiNQxfTY7RW4ho2z5DAAnuwiQzAAA=',\n  'AAMkADI4OGIzNzUxLTRlMGMtNDY2Zi04NmVlLWZhOTFhM2MxNjcwZABGAAAAAACwYBVdW2_fR5jdz7PbeAFBBwCJ_gbiNQxfTY7RW4ho2z5DAAAAAAEMAACJ_gbiNQxfTY7RW4ho2z5DAAnuwiQ0AAA=',\n] : []);\nconst done = new Set(replied.map(r => String(r.message_id || '')).filter(id => id && !REDO.has(id)));\n// Campaigns live in the email_campaigns table: one row per campaign (subject to match, audience, where to open the deal).\nconst campaigns = $('Get campaigns').all().map(i => i.json).filter(c => c.active && c.subject_match)\n  .map(c => Object.assign({}, c, { re: new RegExp(c.subject_match, 'i') }));\nconst dealt = new Set(); // client replies that already opened a deal for this campaign\nfor (const r of replied) if (r.campaign && !REDO.has(String(r.message_id))) dealt.add(r.campaign + '|' + lc(r.email));\nconst out = [];\nfor (const m of $('Get recent mail').all().map(i => i.json)) {\n  const subj = String(m.subject || '');\n  if (/\\[(TEST|SAMPLE)/i.test(subj)) continue;\n  const camp = campaigns.find(c => c.re.test(subj));\n  if (!camp) continue;\n  const email = lc(m.from && m.from.emailAddress && m.from.emailAddress.address);\n  const name = (m.from && m.from.emailAddress && m.from.emailAddress.name) || email;\n  const id = String(m.id || m.internetMessageId || '');\n  if (!/^[^\\s@\\/]+@[^\\s@]+\\.[a-z]+$/.test(email) || /@anagomb\\.ca$/.test(email) || !id || done.has(id) || optout.has(email)) continue;\n  // Auto-replies (out of office, delivery failures) are not real replies.\n  if (/automatic reply|auto.?reply|out of (the )?office|undeliverable|delivery (status|failure)|mail delivery/i.test(subj) || /mailer-daemon|postmaster|no-?reply/i.test(email)) continue;\n  // only the reply itself, not the quoted original (which contains the word unsubscribe)\n  const reply = String(m.bodyPreview || '').split(/\\bFrom:|-----Original|\\bOn .{5,80} wrote:|Hi [^,]{1,40},\\s+(In 20\\d\\d we|It has been about|Snow is on its way)/i)[0].trim();\n  const unsub = /unsubscri|remove me|stop email|take me off/i.test(reply);\n  done.add(id);\n  if (unsub) optout.add(email);\n  const client = camp.audience === 'client';\n  // A polite no gets a task to close the loop, not a deal.\n  const declined = /good for now|all set|not (interested|at this time|right now|this year)|no thanks|no,? thank|pass (on|this)|don'?t need|do not need/i.test(reply);\n  const key = camp.name + '|' + email;\n  const newDeal = client && !unsub && !declined && !dealt.has(key) && !!camp.pipeline_id;\n  if (newDeal) dealt.add(key);\n  out.push({ json: { kind: unsub ? 'unsub' : 'reply', email, name, message_id: id, subject: subj, reply: reply.slice(0, 300),\n    campaign: camp.name, audience: camp.audience, new_deal: newDeal, pipeline_id: camp.pipeline_id || null, stage_id: camp.stage_id || null, deal_title: camp.deal_title || camp.name,\n    next: declined ? 'Looks like a no for now. Nothing to quote; mark this done once you have read it.' : client ? 'Current client replied to \"' + camp.name + '\": confirm the date and price.' : 'If they are interested, reopen their lost deal and book the walkthrough.' } });\n}\nreturn out;\n"
      }
    },
