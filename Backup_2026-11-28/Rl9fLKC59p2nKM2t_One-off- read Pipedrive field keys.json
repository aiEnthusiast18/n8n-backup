      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const pick = f => ({ key: f.key, name: f.name, type: f.field_type, options: (f.options || []).map(o => o.id + ':' + o.label).join(' | ') });\nconst want = /deal type|app client|app site|lead source|po number|monthly value|campaign/i;\nconst d = ($('Deal fields').first().json.data || []).filter(f => want.test(f.name)).map(pick);\nconst o = ($('Org fields').first().json.data || []).filter(f => want.test(f.name)).map(pick);\nconst s = ($('Stages').first().json.data || []).map(x => x.id + ':' + x.name + ':' + x.pipeline_id);\nreturn [{ json: { deal: d, org: o, stages: s } }];"
      },
      "disabled": true
    }
