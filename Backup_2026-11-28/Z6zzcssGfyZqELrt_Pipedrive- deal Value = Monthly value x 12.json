    {
      "id": "03b54ae0-e0ca-46bf-bb45-c2644bf0479e",
      "name": "Deals needing annual value",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const MONTHLY = '655cbcd2e5a131c6c93d0e46b43dd513eb375e8a';\nconst PROGRAM = 'e2d6b7321f684cd972fd6711fb4f9bf02fdf40cf';\nconst PROGRAM_MONTHLY = { '97': 1000, '98': 2000, '99': 3000, '100': 4000, '101': 5000, '102': 6000 }; // Program I..VI initial business per month\nconst deals = $('Get open deals').first().json.data || [];\nconst out = [];\nfor (const d of deals) {\n  if (![1, 3].includes(d.pipeline_id)) continue; // Recurring clients, Franchise sales\n  let m = Number(d[MONTHLY]);\n  let fillMonthly = false;\n  if ((!m || m <= 0) && d.pipeline_id === 3 && d[PROGRAM] != null && PROGRAM_MONTHLY[String(d[PROGRAM])]) {\n    m = PROGRAM_MONTHLY[String(d[PROGRAM])];\n    fillMonthly = true;\n  }\n  if (!m || m <= 0) continue;\n  const annual = Math.round(m * 12 * 100) / 100;\n  if (!fillMonthly && Number(d.value) === annual && d.currency === 'CAD') continue;\n  const body = { value: annual, currency: 'CAD' };\n  if (fillMonthly) { body[MONTHLY] = m; body[MONTHLY + '_currency'] = 'CAD'; }\n  out.push({ json: { id: d.id, body } });\n}\nreturn out;"
      }
    },
    {
      "id": "e4745dd0-62f5-4182-800a-8c67b8722b14",
